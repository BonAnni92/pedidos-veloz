# Copie para .env e ajuste se quiser (cp .env.example .env).
# Sem o .env, o docker-compose.yml usa os valores padrão abaixo.
# NUNCA versione o arquivo .env com senhas reais (ele está no .gitignore).

# Banco de dados
POSTGRES_USER=veloz
POSTGRES_PASSWORD=veloz_dev_123

# Imagens: registry e tag usados pelo Compose
REGISTRY=ghcr.io/bonanni92
IMAGE_TAG=local

# Portas publicadas no host
GATEWAY_PORT=8080
GRAFANA_PORT=3000
JAEGER_PORT=16686
PROMETHEUS_PORT=9090

# Comportamento do serviço de pagamentos (simulação)
PAGAMENTO_LIMITE_CENTAVOS=500000
PAGAMENTO_LATENCIA_MAX_MS=300
PAGAMENTO_TAXA_FALHA=0

LOG_LEVEL=INFO
